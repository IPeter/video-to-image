# Copy to .env.local for `pnpm dev`. In containers these are plain environment
# variables read at request time (one image for every domain).

# Domain served by this frontend (a file name in configs/domains without .yaml).
DOMAIN_KEY=cars
# API base URL as the BROWSER sees it. Its origin (this site's URL) must be listed in
# the domain's allowedOrigins.
API_URL=http://localhost:4000
# Optional: API base URL for server-side fetches (e.g. the in-cluster Service).
# Defaults to API_URL.
# API_INTERNAL_URL=http://v2i-api:4000
