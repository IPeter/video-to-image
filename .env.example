# Copy to .env; the Makefile includes it (`make dev`, `make test`).
# Keep comments on their own lines: make keeps any text before an inline "#".

# ---- core ----
DATABASE_URL=postgres://v2i:v2i@localhost:55432/v2i?sslmode=disable
V2I_HTTP_ADDR=:4000
# /livez and /metrics (keep off the public ingress)
V2I_ADMIN_ADDR=:4001
V2I_DOMAINS_DIR=configs/domains
V2I_SCRATCH_DIR=./data/scratch
# json in production
V2I_LOG_FORMAT=text
V2I_LOG_LEVEL=info

# ---- model ----
# gemini | fake | recording | recorded. `fake` needs no key and returns canned scenes.
V2I_ANALYZER=fake
GEMINI_API_KEY=
V2I_RECORDINGS_DIR=testdata/recordings
V2I_MODEL_CALLS_PER_MINUTE=30
# Pauses the pipeline queue once today's model spend reaches it (0 disables).
DAILY_COST_CEILING_USD=5
# Simulated model latency for the fake analyzer, so progress states are visible.
V2I_FAKE_DELAY=1s

# ---- storage: local disk (default) or MinIO/S3 ----
V2I_STORAGE=local
V2I_STORAGE_DIR=./data/storage
# V2I_STORAGE=s3
# S3_ENDPOINT=http://localhost:59000
# S3_REGION=us-east-1
# S3_BUCKET=v2i
# S3_ACCESS_KEY_ID=v2i-minio
# S3_SECRET_ACCESS_KEY=v2i-minio-secret
# S3_USE_PATH_STYLE=true
# V2I_PRESIGN_DOWNLOADS=false

# ---- API ----
# Bypasses Origin checks and rate limits for non-browser clients. With a paid analyzer
# it must be random and >= 24 characters (openssl rand -hex 24).
V2I_INTERNAL_TOKEN=dev-internal-token
# HMAC key for stored client IP hashes (empty: random per process).
V2I_IP_HASH_SALT=
# CIDRs of reverse proxies whose X-Forwarded-For is trusted (e.g. the k3s pod network
# 10.42.0.0/16 behind Traefik). Empty: use the TCP peer address.
V2I_TRUSTED_PROXIES=
V2I_MAX_CONCURRENT_UPLOADS=4
V2I_MAX_UPLOADS_PER_CLIENT=2
# Largest request body the ingress accepts (95 MiB behind Cloudflare: 99614720); caps the
# single-request upload and keeps upload chunks below it. 0 = no cap.
V2I_MAX_REQUEST_BYTES=0
# Chunked (browser) uploads: chunk size, idle expiry after the last chunk, open uploads
# per client.
V2I_UPLOAD_CHUNK_BYTES=16777216
V2I_UPLOAD_SESSION_TTL=15m
V2I_MAX_UPLOAD_SESSIONS_PER_CLIENT=2
V2I_PIPELINE_WORKERS=2
# Threads per ffmpeg process (bounds memory and CPU per job).
FFMPEG_THREADS=2
# Scene ranges extracted in parallel per job; 0 = auto (CPUs / (FFMPEG_THREADS x
# V2I_PIPELINE_WORKERS)). One 4K HEVC range holds ~450 MiB at FFMPEG_THREADS=2.
V2I_EXTRACT_CONCURRENCY=0

# ---- studio backgrounds (optional) ----
# Segmentation sidecar that cuts the car out of exterior photos for studio backdrops (car
# pixels unchanged). Empty = feature off; http://127.0.0.1:4100 after `make studio-up`;
# `fake` = built-in fake segmenter (tests/e2e, no sidecar). The domain also needs
# `studio.enabled: true` in its YAML.
V2I_STUDIO_URL=
# Per photo (one sidecar call); on errors the studio job retries later.
V2I_STUDIO_TIMEOUT=45s
# Studio jobs at once (River queue "studio"; the sidecar serves one request at a time).
V2I_STUDIO_WORKERS=1

# ---- tests ----
V2I_TEST_DATABASE_URL=postgres://v2i:v2i@localhost:55432/v2i?sslmode=disable
V2I_TEST_S3_ENDPOINT=http://localhost:59000
