# Go
/bin/
/dist/
*.test
coverage.out

# Local runtime data
/data/
/report/
.env

# Test fixtures that are generated (scripts/gen-fixtures.sh)
/testdata/videos/*.mp4
/testdata/videos/*.mov

# Frontend
/web/node_modules/
/web/.next/
/web/out/
/web/test-results/
/web/playwright-report/
/web/.env*.local
/web/next-env.d.ts

# OS / editors
.DS_Store
.idea/
.vscode/
/testdata/videos/*.txt
/web/tsconfig.tsbuildinfo
.playwright-mcp/

# k8s overlay secrets (generated by deploy/k8s/deploy.sh)
/deploy/k8s/overlays/*/secrets.env
/deploy/k8s/overlays/*/gemini.env
/deploy/k8s/overlays/*/basic-auth.users
/deploy/k8s/overlays/*/basic-auth.password

# Local test videos (large, personal: phone videos carry GPS metadata)
/test-video/

# Studio sidecar (services/studio): model files are fetched by fetch-models.sh (~0.6 GB,
# verified against models.sha256), benchmark outputs and Python caches stay local.
/services/studio/models/*
!/services/studio/models/.gitignore
/services/studio/bench*.json
/services/studio/bench-*/
/services/studio/.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
