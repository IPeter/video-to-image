# deploy.sh creates secrets.env (git-ignored) with random values on the first run.
POSTGRES_PASSWORD=<random>
DATABASE_URL=postgres://v2i:<POSTGRES_PASSWORD>@postgres:5432/v2i?sslmode=disable
V2I_INTERNAL_TOKEN=<random, >= 24 chars>
V2I_IP_HASH_SALT=<random>
# gemini.env (git-ignored): GEMINI_API_KEY=... (copied from the repo's .env)
# basic-auth.users (git-ignored): htpasswd -nbB dealer '<password>'
