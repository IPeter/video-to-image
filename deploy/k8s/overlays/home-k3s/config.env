V2I_LOG_FORMAT=json
V2I_ANALYZER=gemini
V2I_DOMAINS_DIR=/etc/v2i/domains
V2I_STORAGE=local
V2I_STORAGE_DIR=/data/storage
V2I_SCRATCH_DIR=/scratch
V2I_TRUSTED_PROXIES=10.42.0.0/16
V2I_CLIENT_IP_HEADER=CF-Connecting-IP
V2I_MAX_REQUEST_BYTES=99614720
V2I_UPLOAD_CHUNK_BYTES=16777216
DAILY_COST_CEILING_USD=5
V2I_PIPELINE_WORKERS=2
V2I_MAX_CONCURRENT_UPLOADS=4
V2I_MAX_UPLOADS_PER_CLIENT=2
FFMPEG_THREADS=2
V2I_EXTRACT_CONCURRENCY=1
# Studio backgrounds: the segmentation sidecar in the worker pod (deploy/k8s/README.md).
# Empty V2I_STUDIO_URL turns the feature off; the domain also needs studio.enabled.
V2I_STUDIO_URL=http://127.0.0.1:4100
V2I_STUDIO_TIMEOUT=45s
V2I_STUDIO_WORKERS=1
